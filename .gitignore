# Barrio Sin Ley Online — .gitignore

# Godot engine
godot/.godot/
godot/export/
*.translation
*.import

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build
godot/build/
*.exe
*.dll
*.pck
*.zip

# Logs
*.log

# Python cache / temp
__pycache__/
*.pyc
*.pyo
*.pyd

# Heavy generated assets (keep prompts/code, ignore outputs)
design/prompts/output/
design/prompts/__pycache__/

# Reference media and raw exports (heavy)
design/references/
*.psd
*.kra
*.xcf
*.blend

# Generic heavy media
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.flac
*.psb
*.tif
*.tiff

# Avoid committing project.addons (godot plugin binary files) unless needed
# godot/addons/*/bin/

# Keep only project files
*.blend1
*.blend2
