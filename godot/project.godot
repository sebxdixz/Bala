; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Barrio Sin Ley Online"
config/description="MMO Action-RPG de mundo abierto en una metropoli decadente. Godot 4, 3D Low Poly."
config/version="0.0.1"
config/tags=PackedStringArray("mmo", "rpg", "action", "open-world", "crime", "low-poly")
run/main_scene="scenes/world/test_world.tscn"
config/features=PackedStringArray("4.6")
config/icon="assets/ui/icon.png"

[audio]

master/mix_rate=44100
master/output_latency=15

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]

ClassStarter="*res://scripts/classes/class_starter.gd"
GameManager="*res://scripts/global/global.gd"
GameSettings="*res://scripts/global/game_settings.gd"
StatsManager="*res://scripts/player/stats.gd"
ItemDatabase="*res://scripts/items/item_database.gd"
ClassManager="*res://scripts/classes/class_manager.gd"
InventoryManager="*res://scripts/items/inventory.gd"
CombatEffects="*res://scripts/combat/combat_effects.gd"
WorldEvents="*res://scripts/world/world_events.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"

[debug]

settings/profile=1

