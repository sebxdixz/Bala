[physics]

3d/physics_engine="godot"
3d/default_gravity=24.0
3d/layer_1="World"
3d/layer_2="Player"
3d/layer_3="NPC"
3d/layer_4="Projectile"
3d/layer_5="Item"
3d/layer_6="Camera"
3d/layer_7="Interaction"
3d/layer_8="Vehicle"

[rendering]

environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
renderer/texture_filter/use_nearest_mipmap_filter=true
renderer/anti_aliasing/quality="low"
renderer/anti_aliasing/use_msaa=0
shaders/use_light_soft_shadows=false
theme/custom="res://assets/fonts/bslo_theme.tres"
