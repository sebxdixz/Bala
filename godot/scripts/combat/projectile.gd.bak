# ============================================================
# projectile.gd — Proyectil de habilidad
# Barrio Sin Ley Online (BSLO)
# Area3D que vuela hacia adelante y aplica danio al impactar.
# ============================================================
extends Area3D

@export var speed: float = 20.0
@export var damage: int = 10
@export var damage_type: String = "physical"
@export var lifetime: float = 3.0

var _time_alive: float = 0.0
var _direction: Vector3 = Vector3.FORWARD
var _attacker: Node = null

func _ready():
    """Configura la colision y conecta senales."""
    body_entered.connect(_on_body_entered)
    area_entered.connect(_on_area_entered)
    # Asegurar que el Area3D detecte colisiones
    set_collision_layer_value(4, true)
    set_collision_mask_value(3, true)

func _physics_process(delta: float):
    """Mueve el proyectil hacia adelante y verifica lifetime."""
    _time_alive += delta
    if _time_alive >= lifetime:
        queue_free()
        return

    global_position += _direction * speed * delta

func setup(direction: Vector3, dmg: int, attacker: Node = null, dmg_type: String = "physical"):
    """Configura el proyectil con direccion, danio y atacante.
    
    Parametros:
        direction: Direccion normalizada de vuelo
        dmg: Cantidad de danio
        attacker: Nodo que origino el ataque
        dmg_type: Tipo de danio
    """
    _direction = direction.normalized()
    damage = dmg
    _attacker = attacker
    damage_type = dmg_type

func _on_body_entered(body: Node3D):
    """Cuando impacta un cuerpo (CharacterBody3D, etc.)."""
    _apply_damage(body)

func _on_area_entered(area: Area3D):
    """Cuando impacta otra area (hitbox, etc.)."""
    _apply_damage(area)

func _apply_damage(target: Node):
    """Aplica danio al objetivo si es valido."""
    if target == _attacker:
        return
    if target.is_in_group("players") and _attacker and _attacker.is_in_group("players"):
        return

    if target.has_method("take_damage"):
        target.take_damage(damage)
        queue_free()
    elif target.get_parent() and target.get_parent().has_method("take_damage"):
        target.get_parent().take_damage(damage)
        queue_free()
    else:
        queue_free()
